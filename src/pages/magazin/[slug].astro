---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Basis from '../../layouts/Basis.astro';
import Foto from '../../components/Foto.astro';
import ArtikelListe from '../../components/ArtikelListe.astro';
import Icon from '../../components/Icon.astro';
import { alleArtikel, lesezeit, datumLang, datumIso, zielgruppen, stufeName, type Artikel } from '../../magazin';
import { inhalt, ORIGIN, mitBasis } from '../../inhalt';

export async function getStaticPaths() {
  const liste = await alleArtikel();
  return liste.map((a) => ({ params: { slug: a.id }, props: { artikel: a, weitere: liste.filter((b) => b.id !== a.id).slice(0, 3) } }));
}
interface Props { artikel: Artikel; weitere: Artikel[]; }
const { artikel, weitere } = Astro.props;
const d = artikel.data;
const name = (t: string) => t.replaceAll('{{NAME}}', inhalt.name);
const html = name(artikel.rendered?.html ?? '');
const minuten = lesezeit(artikel.body ?? '');
const fotos = import.meta.glob<{ default: ImageMetadata }>('../../fotos/*.jpg', { eager: true });
const og = await getImage({ src: fotos[`../../fotos/${d.foto}.jpg`].default, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 78 });
const url = `${inhalt.domain}/magazin/${artikel.id}/`;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: name(d.titel),
  description: name(d.beschreibung),
  datePublished: datumIso(d.datum),
  dateModified: datumIso(d.datum),
  inLanguage: 'de',
  mainEntityOfPage: url,
  image: ORIGIN + mitBasis(og.src),
  author: { '@type': 'Organization', name: `Redaktion ${inhalt.name}`, url: `${inhalt.domain}/magazin/` },
  publisher: { '@type': 'Organization', name: inhalt.anbieter, url: inhalt.anbieterUrl },
  wordCount: (artikel.body ?? '').split(/\s+/).filter(Boolean).length,
  about: d.zielgruppen.map((z) => zielgruppen[z]),
};
---
<Basis titel={name(d.titel)} beschreibung={name(d.beschreibung)} ogBild={og.src} ogTyp="article">
  <script slot="kopf" type="application/ld+json" set:html={JSON.stringify(schema)} />
  <meta slot="kopf" property="article:published_time" content={datumIso(d.datum)} />
  <article class="artikel">
    <header class="artikel-kopf">
      <div class="rahmen">
        <p class="ort"><a href="/">Start</a> / <a href="/magazin/">Magazin</a></p>
        <h1>{name(d.titel)}</h1>
        <p class="lead">{name(d.beschreibung)}</p>
        <p class="artikel-meta"><span>{d.autor}</span><time datetime={datumIso(d.datum)}>{datumLang(d.datum)}</time><span>{minuten} Min. Lesezeit</span></p>
      </div>
    </header>
    <div class="rahmen artikel-foto">
      <Foto name={d.foto} form="quer" fokus={d.fokus} laden="eager" sizes="(min-width: 1320px) 1220px, 100vw" alt={d.fotoAlt} ort={d.fotoOrt} />
    </div>
    <div class="rahmen artikel-raster">
      <aside class="artikel-seite" aria-label="Zum Beitrag">
        <dl>
          <dt>Für</dt>
          <dd>{d.zielgruppen.map((z) => <a href={`/magazin/fuer/${z}/`}>{zielgruppen[z]}</a>)}</dd>
          <dt>Stufe</dt>
          <dd>{d.stufen.map((s) => <a href={`/magazin/stufe/${s}/`}>{stufeName(s)}</a>)}</dd>
          <dt>Von</dt>
          <dd class="text">{d.autor}. Ein Projekt von <a href={inhalt.anbieterUrl}>{inhalt.anbieter}</a>.</dd>
        </dl>
      </aside>
      <div class="artikel-text" set:html={html} />
    </div>
  </article>

  {weitere.length > 0 && (
    <section class="abschnitt eng kante">
      <div class="rahmen">
        <div class="kopfzeile"><h2>Weiterlesen</h2><p class="lead"><a class="pfeil" href="/magazin/">Alle Beiträge <Icon name="pfeil" /></a></p></div>
        <ArtikelListe artikel={weitere} gross={false} />
      </div>
    </section>
  )}
</Basis>
