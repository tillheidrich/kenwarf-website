---
// Ausschnitt aus der laufenden Weboberfläche mit den Beispieldaten der Tischlerei Wendt.
interface Props { src: string; alt: string; pfad?: string; breite?: number; hoehe?: number; laden?: 'lazy' | 'eager'; klasse?: string; }
const { src, alt, pfad = 'Weboberfläche mit Beispieldaten der Tischlerei Wendt', breite = 1440, hoehe = 900, laden = 'lazy', klasse = '' } = Astro.props;
---
<figure class={`bild ${klasse}`}>
  <img src={src} alt={alt} width={breite} height={hoehe} loading={laden} decoding="async" />
  <figcaption>{Astro.slots.has('default') && <slot />}<span class="herkunft">{pfad}</span></figcaption>
</figure>
