---
import '@fontsource-variable/archivo/standard.css';
import '@fontsource-variable/martian-mono/standard.css';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Fuss from '../components/Fuss.astro';
import { inhalt, ORIGIN, mitBasis } from '../inhalt';

interface Props { titel: string; beschreibung: string; start?: boolean; ogBild?: string; ogTyp?: 'website' | 'article'; kopfExtra?: boolean; }
const { titel, beschreibung, start = false, ogBild = '/og.jpg', ogTyp = 'website' } = Astro.props;
const ogUrl = ORIGIN + mitBasis(ogBild);
const url = ORIGIN + mitBasis(Astro.url.pathname);
const voll = start ? titel : `${titel} · ${inhalt.name}`;
const schema = start ? [{
  '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: inhalt.name,
  applicationCategory: 'BusinessApplication', operatingSystem: 'Linux (Docker)', description: beschreibung, inLanguage: 'de', url,
  publisher: { '@type': 'Organization', name: inhalt.anbieter, url: inhalt.anbieterUrl },
}] : [];
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{voll}</title>
    <meta name="description" content={beschreibung} />
    {inhalt.noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={url} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#f5f7fa" />
    <meta property="og:type" content={ogTyp} />
    <meta property="og:site_name" content={inhalt.name} />
    <meta property="og:title" content={voll} />
    <meta property="og:description" content={beschreibung} />
    <meta property="og:url" content={url} />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="alternate" type="application/rss+xml" title={`Magazin · ${inhalt.name}`} href="/magazin/rss.xml" />
    <slot name="kopf" />
    {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip" href="#inhalt">Zum Inhalt springen</a>
    {inhalt.prototypHinweis && <aside class="vorschau-band" aria-label="Hinweis zum Stand"><div class="rahmen"><strong>Vorschau, noch nicht gestartet.</strong> <span>Managed-Dienst, Testphase und Preise gibt es noch nicht. Der Quellcode ist eine Vorabversion in aktiver Entwicklung.</span></div></aside>}
    <Nav />
    <main id="inhalt"><slot /></main>
    <Fuss />
    <script>
      const els = document.querySelectorAll<HTMLElement>('[data-zeige], [data-zieh]');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((es) => {
          for (const e of es) if (e.isIntersecting) { e.target.classList.add('sichtbar'); io.unobserve(e.target); }
        }, { rootMargin: '0px 0px -6% 0px', threshold: 0.05 });
        els.forEach((el) => io.observe(el));
      } else els.forEach((el) => el.classList.add('sichtbar'));
    </script>
  </body>
</html>
